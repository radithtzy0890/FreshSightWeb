{
  "name": "freshsight-monorepo",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@freshsight/web",
    "build": "npm run build --workspace=@freshsight/web",
    "dev:web": "npm run dev --workspace=@freshsight/web",
    "build:web": "npm run build --workspace=@freshsight/web"
  }
}
